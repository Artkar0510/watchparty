# Postgres (shared by auth_db, content_db)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# JWT signing key for auth-service (CHANGE IN PRODUCTION)
SECRET_KEY=change-me-in-production-use-long-random-string

# Common
DEBUG=false

# RabbitMQ (event bus for ugc/auth/together → notification)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# MongoDB (UGC service: likes, bookmarks, reviews)
MONGO_DATABASE=ugc_db

# Sentry (optional — leave empty to disable; integrated in all FastAPI services)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
