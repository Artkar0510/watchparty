# Шаблон переменных окружения для together-service.
# Скопируй в .env и подправь под себя:
#   cp .env.example .env
#
# Pydantic-Settings читает их с разделителем `__`: APP__DEBUG → app.debug.

# --- App ----------------------------------------------------------------
APP__PROJECT_NAME=together-service
APP__DEBUG=false
APP__API_V1_PREFIX=/api/v1
# Сколько секунд живёт сессия в Redis после последней активности.
APP__SESSION_TTL=86400

# --- Redis (pub/sub + хранение состояния сессий) ------------------------
REDIS__HOST=redis
REDIS__PORT=6379
# REDIS__PASSWORD=

# --- Auth service (для верификации JWT) ---------------------------------
AUTH__SERVICE_URL=http://auth-service:8000

# --- Content service (опционально, на будущее) --------------------------
CONTENT__SERVICE_URL=http://content-service:8000

# --- RabbitMQ (публикация событий together.events) ----------------------
RABBIT__HOST=rabbitmq
RABBIT__PORT=5672
RABBIT__USER=guest
RABBIT__PASSWORD=guest
# Поставь false, если хочешь поднять сервис без брокера — публикация
# превратится в no-op, остальное продолжит работать.
RABBIT__ENABLED=true

# --- Sentry (мониторинг ошибок) -----------------------------------------
# Пустой DSN полностью отключает Sentry.
SENTRY__DSN=
SENTRY__ENVIRONMENT=development
SENTRY__TRACES_SAMPLE_RATE=0.0
